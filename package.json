{
  "name": "tradeez",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "// dev": "shared 需先构建：其 exports 指向 dist，Node 与 Vite 都从那里解析",
    "dev": "pnpm --filter @tradeez/shared build && pnpm --filter @tradeez/web dev",
    "dev:api": "pnpm --filter @tradeez/shared build && pnpm --filter @tradeez/api dev",
    "dev:shared": "pnpm --filter @tradeez/shared dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
