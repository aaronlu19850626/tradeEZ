# 服务器上复制为 /opt/tradeez/.env 并填入真实值。此文件不含任何真实凭据。

# 数据库。密码用 openssl rand -base64 32 生成
POSTGRES_DB=tradeez
POSTGRES_USER=tradeez
POSTGRES_PASSWORD=

# access token 签名密钥。用 openssl rand -base64 48 生成
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# 前后端同域部署，无需 CORS，留空
CORS_ORIGIN=

# 微信开放平台凭据。留空则关闭扫码登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
