# 自动申请并续期 Let's Encrypt 证书。DNS 已指向本机，无需额外配置。

# www 统一 301 到裸域，避免两个规范地址导致 cookie 作用域混乱
www.tradeez.cn {
	redir https://tradeez.cn{uri} permanent
}

tradeez.cn {
	encode zstd gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# HSTS 一年。一旦下发，浏览器在有效期内强制 HTTPS，
		# 回退到 HTTP 需等过期 —— 上线前确认证书链稳定
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API 反代到容器内的 api 服务
	handle /api/* {
		reverse_proxy api:3000
	}

	# 前端静态文件。缓存头必须写在 handle 内 ——
	# handle 是终结性路由，块外的 header 指令进不了这条链路
	handle {
		root * /srv/web

		# /assets/ 下全是 Vite 产出的带内容哈希文件（name-HASH.js），可永久缓存。
		# 按目录匹配而非按哈希正则 —— Vite 用连字符分隔哈希，正则易写错
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html 必须不缓存，否则发版后用户拿旧壳引用已删除的 chunk
		@html path / /index.html
		header @html Cache-Control "no-cache, must-revalidate"

		# SPA 路由回退，否则刷新 /journal/dashboard 会 404
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
