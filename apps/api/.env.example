# 复制为 .env.local 后填入真实值。.env.local 不入库。

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://tradeez:tradeez@localhost:5432/tradeez
REDIS_URL=redis://localhost:6379

# 生产环境用 openssl rand -base64 48 生成
JWT_SECRET=dev-only-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# 同域部署留空；前后端分域时填前端来源，逗号分隔
CORS_ORIGIN=http://localhost:5173

# 微信开放平台凭据。留空则关闭扫码登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
