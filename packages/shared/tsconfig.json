{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    // nodenext 会强制相对 import 带扩展名，正是 Node ESM 运行时的要求，
    // 让编译期就拦住「产物在 Node 下 import 失败」这类问题
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    // 必须产出真实 JS 与 .d.ts：Node 运行时无法 import .ts，
    // 若 exports 指向源码，API 容器启动即崩
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
